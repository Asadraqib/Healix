# Copy this file to .env beside compose.yaml. Supply your own values.
POSTGRES_PASSWORD=
# Same secret is passed to auth and gateway; use at least 32 ASCII characters.
JWT_SECRET=
# Optional. AI endpoints return a clear 503 unavailable state until configured.
GROQ_API_KEY=
# Set false when all machines should use connected adapter readings only.
TELEMETRY_GENERATOR_ENABLED=true
FRONTEND_PORT=8088
GATEWAY_PORT=8080

# Select a model available to your Groq account.
GROQ_MODEL=qwen/qwen3.8-27b

# Local startup: empty URL uses persistent embedded Qdrant. Compose uses its qdrant service.
QDRANT_URL=
QDRANT_API_KEY=
# Optional local storage location; default .runtime/qdrant
QDRANT_PATH=

# Gateway request budget per client IP; background record refresh runs every 15 seconds.
GATEWAY_RATE_LIMIT_PER_MINUTE=300
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
