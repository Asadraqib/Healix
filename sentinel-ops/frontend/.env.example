# Set this to the Spring Cloud Gateway URL to enable live API mode.
# Example: http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api

# Optional. Defaults to ws(s)://<current-host>/ws/simulation.
# Example: ws://localhost:8080/ws/simulation
VITE_WS_URL=

# Live mode is also enabled automatically when VITE_API_BASE_URL is set.
VITE_ENABLE_LIVE_API=false